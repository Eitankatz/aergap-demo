# Copy to .env.local (cp .env.example .env.local). All optional.

# Hermes dashboard to proxy to (HTTP + WebSocket) for the agent-activity feed
# and policy events. Default matches `hermes dashboard`.
DASHBOARD_URL=http://127.0.0.1:9119

# Agent server for the operator phone's owner endpoints (approve/deny/revoke).
# Default matches the local stub; after the Stage-2 swap, point at the live
# server (or the SSH-tunneled localhost port).
AGENT_SERVER_URL=http://127.0.0.1:9740

# Dev server port for this UI.
PORT=5180

# Optional: pre-fill the dashboard session token field. If blank, the UI
# auto-scrapes window.__HERMES_SESSION_TOKEN__ from the proxied dashboard.
# VITE_SESSION_TOKEN=

# The operator (owner) token is entered in the UI's "operator token" field —
# it is the OWNER principal token (AGENT_OWNER_API_TOKEN), never the agent token.
# Not needed in Sample mode (the phone runs offline on seeded cards).
