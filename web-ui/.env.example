# Copy to .env.local (cp .env.example .env.local). All optional.

# Dashboard to proxy to (HTTP + WebSocket). Default matches `hermes dashboard`.
DASHBOARD_URL=http://127.0.0.1:9119

# Dev server port for this UI.
PORT=5180

# Optional: pre-fill the dashboard session token field. If blank, the UI
# auto-scrapes window.__HERMES_SESSION_TOKEN__ from the proxied dashboard (works
# in loopback mode). For a stable token, start the dashboard with:
#   HERMES_DASHBOARD_SESSION_TOKEN=<your-token> hermes dashboard --tui
# VITE_SESSION_TOKEN=
