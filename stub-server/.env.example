# Stub server config. Copy to .env (cp .env.example .env) to override defaults.
# The stub runs fine with NO .env — these are the defaults it uses.

# Port + host the stub binds. 9740 matches the live server's port, so
# AGENT_SERVER_URL=http://localhost:9740 works for both stub and tunnel.
STUB_PORT=9740
STUB_HOST=127.0.0.1

# Auth mode: strict (owner token required on /owner/*) or off (no checks).
# Keep 'strict' to demonstrate principal separation (agent token cannot approve).
STUB_AUTH=strict

# The two principals' tokens. These MUST match what the agent + owner sides send:
#   - agent-mcp binary uses AGENT_API_TOKEN
#   - owner-scripts/.env uses AGENT_OWNER_API_TOKEN
# They MUST differ from each other.
AGENT_API_TOKEN=demo-agent-token
AGENT_OWNER_API_TOKEN=demo-owner-token

# Optional: comma-separated sanctions blocklist (terminal, no override).
# AGENT_BLOCKLIST=sanctioned-addr
