# Owner principal config — copy to .env and fill in. Keep .env out of git.
#
# Uses the same env names as the agent-mcp binary, so one .env serves the whole demo.
#
# AGENT_OWNER_API_TOKEN is the OWNER principal. It must be DIFFERENT from the agent
# token Hermes uses in terminal 1. That difference is what makes the demo's
# separation-of-principals real rather than cosmetic.

AGENT_SERVER_URL=http://localhost:9740
AGENT_OWNER_API_TOKEN=replace-with-owner-token

# Optional context for nicer output / convenience.
AGENT_ID=
WALLET_ID=
